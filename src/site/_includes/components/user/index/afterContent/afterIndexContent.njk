<script>
  (function () {
    const art = document.querySelector(".ascii-art");
    const wrap = document.querySelector(".ascii-art-wrap");
    if (!art || !wrap) return;

    const fitAsciiToWidth = () => {
      art.style.fontSize = "0.56rem";
      const baseSizePx = parseFloat(getComputedStyle(art).fontSize);
      const ratio = wrap.clientWidth / art.scrollWidth;
      if (ratio < 1) {
        art.style.fontSize = `${Math.max(2.5, baseSizePx * ratio)}px`;
      }
    };

    fitAsciiToWidth();
    window.addEventListener("resize", fitAsciiToWidth);
  })();
</script>
