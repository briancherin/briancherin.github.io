{% set breadcrumbs = userComputed.noteFolderBreadcrumbs %}
{% if breadcrumbs and breadcrumbs.length %}
  <div class="note-folder-path align-icon">
    <i icon-name="folder"></i>
    <span class="note-folder-trail">
      <i>
        {% for crumb in breadcrumbs %}
          <a href="{{ crumb.url }}">{{ crumb.name }}</a>{% if not loop.last %} &gt; {% endif %}
        {% endfor %}
      </i>
    </span>
  </div>
{% endif %}
